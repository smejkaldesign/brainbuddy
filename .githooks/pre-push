#!/bin/bash
# Nothing is staged at push time, so asking git for staged files checked zero
# of them and passed. Check what's actually being pushed instead.
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel)

RANGE_FILES=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    RANGE_FILES="$RANGE_FILES $(git diff --name-only "$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$local_sha")" "$local_sha" 2>/dev/null || true)"
  else
    RANGE_FILES="$RANGE_FILES $(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)"
  fi
done

# no refs on stdin (manual run) or nothing resolved: fall back to the whole tree
if [ -z "$(echo "$RANGE_FILES" | tr -d '[:space:]')" ]; then exec "$ROOT/scripts/leak-guard.sh"; fi
exec "$ROOT/scripts/leak-guard.sh" $RANGE_FILES
